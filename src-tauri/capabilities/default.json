{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "module-alert",
    "update-progress"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:default",
    "opener:default",
    "updater:default",
    "allow-restart-app",
    "allow-close-update-progress",
    "allow-open-external",
    "allow-greet"
  ]
}
